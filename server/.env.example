PORT=5050
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/pawtrack?retryWrites=true&w=majority

# URL of the frontend — used for CORS. In production set to your deployed client URL.
CLIENT_ORIGIN=http://localhost:5173

# Minimum 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google AI Studio API key (free tier works for development)
GEMINI_API_KEY=
